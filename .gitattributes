# Windows-only tooling: PowerShell keeps CRLF so scripts behave natively on the one
# platform this targets. Docs stay LF so diffs and GitHub rendering are clean.
* text=auto

*.ps1        text eol=crlf
*.psm1       text eol=crlf
*.cmd        text eol=crlf
*.bat        text eol=crlf

*.md         text eol=lf
*.json       text eol=lf
.gitignore   text eol=lf
.gitattributes text eol=lf
LICENSE      text eol=lf
